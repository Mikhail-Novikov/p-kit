//- Все примеси в этом файле должны начинаться c имени блока (field-select)

mixin field-select(selectedValue, options, wrapperClass, selectValueClass, dropdownClass, dropdownListClass)
  //- Принимает:
  //-   selectedValue:    {string} - текст выбранного значения
  //-   options {array}
  //-     {object}
  //-       title: ''     {string} - текст пункта
  //-       attrs:        {object} - атрибуты li элемента
  //-         'data-code': {string}
  //-   wrapperClass:     {string} - класс для .custom-select-wrapper
  //-   selectValueClass: {string} - класс для .select-value (default: 'select-value')
  //-   dropdownClass:    {string} - класс для .dropdown-wrapper
  //-   dropdownListClass: {string} - класс для ul (default: 'where-dropdown')
  //- Вызов:
    +field-select(
      'Бизнес-центры',
      [
        {
          title: 'Все объекты',
          attrs: {
            'data-code': 'all'
          }
        },
        {
          title: 'Бизнес-центры',
          attrs: {
            'data-code': 'biznes-centry'
          }
        },
      ],
      'where-wrapper',
      'where-countries select-value',
      '',
      'where-dropdown'
    )

  -
    var wrapper = wrapperClass || 'custom-select-wrapper';
    var selectVal = selectValueClass || 'select-value';
    var dropdown = dropdownClass || 'dropdown-wrapper';
    var listClass = dropdownListClass || 'where-dropdown';

  div(class=wrapper)
    .custom-select-box.field-select
      div(class=selectVal)= selectedValue
      div(class=dropdown)
        ul(class=listClass)
          each option in options
            li&attributes(option.attrs)= option.title
